[doc('Type-check source, tests, tooling, and workspace project references')]
[group('Checks')]
typecheck:
    pnpm exec tsc --build tsconfig.json tsconfig.typecheck.json

[doc('Watch source, tests, tooling, and workspace project references')]
[group('Development')]
typecheck-watch:
    pnpm exec tsc --build tsconfig.json tsconfig.typecheck.json --watch

[doc('Build all project artifacts')]
[group('Core')]
build:
    pnpm exec tsc --build

[doc('Watch and rebuild all project artifacts')]
[group('Development')]
build-watch:
    pnpm exec tsc --build --watch
